# Build output
bin/
obj/

# Thunderstore zips from package.ps1. Rebuildable from the tagged source, and a binary
# nobody can diff.
dist/

# Local IDE / user files
*.user
*.suo
.vs/
.idea/

# BepInEx test profile: third-party binaries, not ours to redistribute.
# Recreate by copying the BepInEx tree from any existing profile.
testprofile/

# Thunderstore packaging: staging folder and the zips tcli writes.
package/
build/

# Preview renders. Regenerable from the build script, and a diff of binaries hides the one
# that was actually worked on. Hand-modelled .obj / .col / .png assets ARE committed.
renders/
assets/previews/

# The design script's own output. Every shape it writes is regenerable from
# tools/halter_designs.py, and the four that ship were moved up into assets/ - which is
# what "this one earned its place" looks like in a diff.
assets/variants/

# Blender leaves these beside the tools it imports.
__pycache__/
